{
  "info": {
    "_postman_id": "a91b3e80-7212-4f3b-9a41-2c1f9b3109a1",
    "name": "NewShop MSA API Test Collection",
    "description": "NewShop 마이크로서비스 플랫폼의 E2E 통합 테스트 컬렉션 (API Gateway, User, Product, Order, Payment)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. User Service",
      "item": [
        {
          "name": "1.1 회원가입 (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('회원가입 성공 (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"name\": \"테스터\",\n  \"phone\": \"010-9876-5432\",\n  \"address\": \"서울특별시 강남구 테헤란로 152\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            }
          }
        },
        {
          "name": "1.2 로그인 및 JWT 발급 (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('로그인 성공 및 JWT 토큰 저장 (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.accessToken).to.not.be.empty;",
                  "    pm.environment.set('accessToken', json.data.accessToken);",
                  "    pm.environment.set('userId', json.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "login"]
            }
          }
        },
        {
          "name": "1.3 내 프로필 조회 (Get Profile)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('내 정보 조회 성공 (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.email).to.eql(pm.environment.get('userEmail'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Product Service",
      "item": [
        {
          "name": "2.1 상품 등록 (Create Product)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상품 등록 성공 (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.not.be.null;",
                  "    pm.environment.set('productId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"고성능 게이밍 기계식 키보드\",\n  \"description\": \"체리 MX 적축 스위치 탑재 및 RGB 백라이트 지원\",\n  \"price\": 149000,\n  \"stockQuantity\": 50,\n  \"category\": \"전자제품\",\n  \"imageUrl\": \"https://images.unsplash.com/photo-1587829741301-dc798b83add3\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "2.2 상품 목록 조회 (List Products)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상품 목록 페이징 조회 성공 (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.content).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?category=전자제품&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                {
                  "key": "category",
                  "value": "전자제품"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 상품 단건 조회 (Redis Cache Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('상품 단건 조회 성공 및 Redis 캐시 적중', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.eql(pm.environment.get('productId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Order & Payment Service (Kafka SAGA)",
      "item": [
        {
          "name": "3.1 주문 접수 (Create Order - Kafka SAGA Trigger)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('주문 접수 성공 (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.id).to.not.be.null;",
                  "    pm.expect(json.data.status).to.eql('PENDING');",
                  "    pm.environment.set('orderId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"productName\": \"고성능 게이밍 기계식 키보드\",\n      \"quantity\": 1,\n      \"price\": 149000\n    }\n  ],\n  \"shippingAddress\": \"서울특별시 서초구 반포대로 201\",\n  \"receiverName\": \"테스터\",\n  \"receiverPhone\": \"010-9876-5432\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "3.2 내 주문 목록 조회 (Get My Orders)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('주문 내역 조회 성공', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.content).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my"]
            }
          }
        },
        {
          "name": "3.3 주문별 결제 내역 확인 (Get Payment by Order)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('결제 완료 내역 확인 성공', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.orderId).to.eql(pm.environment.get('orderId'));",
                  "    pm.expect(json.data.status).to.eql('SUCCESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "order", "{{orderId}}"]
            }
          }
        }
      ]
    }
  ]
}
